# This functions works only for libgcc so far.
def generate_libgcc_prerequisites(cfg: PrerequisitesGeneratorConfiguration):
    logging.info("Generating prerequisites for libgcc.")

    # Retrieve a list of all .o files in a library.
    libgcc_library_path = Path(cfg.build_dir_path).joinpath(cfg.triplet, "libgcc", "libgcc.a")
    libgcc_object_file_names = find_library_object_files(libgcc_library_path)

    # Add crt*.o object files from libgcc bundle too.
    crt_object_file_names = ["crtbegin.o", "crtend.o", "crti.o", "crtn.o"]

    # Add all object files to a single list.
    all_object_file_names = libgcc_object_file_names + crt_object_file_names
    logging.debug("Retrieved this list of object files:\n%s", str(all_object_file_names))

    # Convert all object files to .dep files with .c and .h dependencies.
    dep_file_names = list(map(lambda name: name.replace(".o", ".dep"), all_object_file_names))
    logging.debug("Retrieved this list of dep files:\n%s", str(dep_file_names))

    # Retrieve of dependencies from all .dep files.
    dependencies = set()

    for dep_file_name in dep_file_names:
        dep_file_path = libgcc_library_path.parent.joinpath(dep_file_name)
        dependencies.update(parse_dep_file_dependencies(dep_file_path))

    dependencies = sorted(list(dependencies))
    logging.debug("The final list of dependencies:\n%s", "\n".join(dependencies))

    # Prepare output directories.
    output_dir_path = Path(cfg.buildlib_dir_path)
    output_dir_path.mkdir(parents=True, exist_ok=True)
    output_build_dir_path = output_dir_path.joinpath("build")
    output_build_dir_path.mkdir(exist_ok=True)
    output_sources_dir_path = output_dir_path.joinpath("gcc")
    output_sources_dir_path.mkdir(exist_ok=True)

    # Copy all dependencies to a separate directory.
    for source_dependency_file_path in dependencies:
        source_dependency_file_path = Path(source_dependency_file_path)

        # An original dependency must reside in sources or build directory.
        # Otherwise we've encountered a faulty path.
        if source_dependency_file_path.is_relative_to(cfg.build_dir_path):
            destination_dependency_file_path = output_build_dir_path.joinpath(source_dependency_file_path.relative_to(cfg.build_dir_path))
        elif source_dependency_file_path.is_relative_to(cfg.gcc_sources_dir_path):
            destination_dependency_file_path = output_sources_dir_path.joinpath(source_dependency_file_path.relative_to(cfg.gcc_sources_dir_path))
        else:
            logging.error("Dependency is not in build or source directory: %s", source_dependency_file_path)
            sys.exit(1)

        destination_dependency_file_path.parent.mkdir(parents=True, exist_ok=True)

        if destination_dependency_file_path.exists():
            os.remove(destination_dependency_file_path)

        shutil.copy(source_dependency_file_path, destination_dependency_file_path, follow_symlinks=False)

    # Create a skeleton of Makefile for libgcc.
    makefile_path = Path(output_build_dir_path).joinpath(cfg.triplet, "libgcc", "Makefile")
    logging.info("Opening Makefile for write for libgcc: %s", makefile_path)
    makefile_file = makefile_path.open(mode="w", encoding="utf-8")
    makefile_file.writelines(
        [
            ".PHONY: all install clean\n\n",
            "TRIPLET ?= {}\n".format(cfg.triplet),
            "GCC ?= $(TRIPLET)-gcc\n",
            "DESTDIR ?= ../../../install\n",
            "INSTALL_SUBDIR := lib/gcc/$(TRIPLET)/$(shell $(GCC) -dumpfullversion)\n"
            "OBJECTS_LIBGCC := {}\n".format(" ".join(libgcc_object_file_names)),
            "OBJECTS_CRT := {}\n".format(" ".join(crt_object_file_names)),
            "OBJECTS_ALL := $(OBJECTS_LIBGCC) $(OBJECTS_CRT)\n\n",
            "all: libgcc.a $(OBJECTS_ALL)\n\n",
            "install: libgcc.a $(OBJECTS_CRT)\n",
            "\tmkdir -p $(DESTDIR)/$(INSTALL_SUBDIR)\n",
            "\tcp -f $^ $(DESTDIR)/$(INSTALL_SUBDIR)\n\n",
            "clean:\n",
            "\trm -f libgcc.a $(OBJECTS_ALL)\n\n",
            "libgcc.a: $(OBJECTS_LIBGCC)\n",
            "\triscv64-snps-elf-ar rc $@ $^\n",
            "\triscv64-snps-elf-ranlib $@\n\n",
        ]
    )

    # Find a build line in libgcc's build log for each object file.
    for object_file_name in all_object_file_names:
        build_command = find_multiline_object_build_command(object_file_name, cfg.build_log_path)
        logging.debug("Build line for %s:\n%s", object_file_name, build_command)

        build_command_arguments = []
        is_isystem = False
        is_mt_mf = False

        # Remove extra and duplicated arguments.
        for chunk in build_command.split():
            if chunk.endswith("xgcc") or chunk.startswith("-B"):
                # We are not going to use xgcc from the original build and
                # extra -B include flags.
                continue
            elif chunk in ["-MD", "-MP", "-g", "-O0", "-O1", "-O2", "-O3", "-Ofast", "-Os"]:
                # Skip all unnecessary and optimization options from the original build.
                continue
            elif chunk == "-isystem":
                # We don't need -isystem includes. GCC will use includes from
                # a prebuilt bundle.
                is_isystem = True
            elif is_isystem:
                is_isystem = False
            elif chunk in ["-MT", "-MF"]:
                # We can skip -MT and -MF with its arguments.
                is_mt_mf = True
            elif is_mt_mf:
                is_mt_mf = False
            else:
                # Add a flag to the final build command if it's not duplicated.
                if chunk not in build_command_arguments:
                    build_command_arguments.append(chunk)

        # Craft a final build command and append CFLAGS for extra
        # target argument.
        build_command = "$(GCC) {} $(CFLAGS)".format(" ".join(build_command_arguments))

        # Now we have a build command for a object file. Add it to a Makefile.
        makefile_target = "{}:\n\t{}\n\n".format(object_file_name, build_command)
        makefile_file.write(makefile_target)
        logging.debug("Final build command for %s:\n%s", object_file_name, build_command)

    makefile_file.close()


def generate_picolibc_prerequisites(cfg: PrerequisitesGeneratorConfiguration):
    logging.info("Generating prerequisites for Picolibc.")
    shutil.copytree(cfg.picolibc_sources_dir_path, os.path.join(cfg.buildlib_dir_path, "picolibc"))


def build_libgcc(cfg: BuilderConfiguration):
    libgcc_dir_path = Path(cfg.buildlib_dir_path).joinpath("build", cfg.triplet, "libgcc").resolve()

    arguments = 'make install CFLAGS="{}" DESTDIR="{}"'.format(cfg.cflags, cfg.install_dir_path)
    logging.info("Building a configuration: %s", arguments)

    if logging.getLogger().getEffectiveLevel() == logging.DEBUG:
        result = subprocess.run(arguments, encoding="utf-8", cwd=str(libgcc_dir_path), shell=True)

        if result.returncode != 0:
            logging.error("Error while building libgcc.")
            sys.exit(1)
    else:
        result = subprocess.run(arguments, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, encoding="utf-8", cwd=str(libgcc_dir_path), shell=True)

        if result.returncode != 0:
            logging.error("Error while building libgcc:\n%s", result.stdout)
            sys.exit(1)

ARGPARSE_COMMAND_PREPARE_STAGE1 = "prepare-stage1"
ARGPARSE_COMMAND_PREPARE_STAGE2 = "prepare-stage2"
ARGPARSE_COMMAND_BUILD = "build"


def main():
    # Derive a triplet from script's name and try to locate a path to a GCC binary.
    triplet = os.path.basename(__file__).rsplit("-", maxsplit=1)[0]

    gcc_binary_name = '{}-gcc'.format(triplet)
    gcc_binary_path = shutil.which(gcc_binary_name)

    if gcc_binary_path:
        logging.info("Found GCC in PATH: %s", gcc_binary_path)
    else:
        gcc_binary_path = Path(__file__).parent.joinpath(gcc_binary_name)
        if gcc_binary_path.exists():
            logging.info("Found GCC in a local directory: %s", str(gcc_binary_path))
        else:
            logging.error("Cannot find GCC in PATH or in a local directory.")
            return 1

    # Create command line arguments parsers for these commands:
    #
    #     prepare-stage1
    #     prepare-stage2
    #     build
    #

    parser = argparse.ArgumentParser(prog=os.path.basename(__file__), description="Buildlib for ARC-V GNU toolchain.")
    parser.add_argument("--debug", action="store_true")
    subparsers = parser.add_subparsers(dest="command")

    parser_prepare = subparsers.add_parser(ARGPARSE_COMMAND_PREPARE_STAGE1, formatter_class=argparse.ArgumentDefaultsHelpFormatter)
    parser_prepare.add_argument("--workspace-dir-path", type=str, required=True, metavar="PATH")
    parser_prepare.add_argument("--gcc-sources-dir-path", type=str, required=True, metavar="PATH")
    parser_prepare.add_argument("--picolibc-sources-dir-path", type=str, required=True, metavar="PATH")

    parser_prepare = subparsers.add_parser(ARGPARSE_COMMAND_PREPARE_STAGE2, formatter_class=argparse.ArgumentDefaultsHelpFormatter)
    parser_prepare.add_argument("--build-log-path", type=str, required=True, metavar="PATH")
    parser_prepare.add_argument("--build-dir-path", type=str, required=True, metavar="PATH")
    parser_prepare.add_argument("--gcc-sources-dir-path", type=str, required=True, metavar="PATH")
    parser_prepare.add_argument("--picolibc-sources-dir-path", type=str, required=True, metavar="PATH")
    parser_prepare.add_argument(
        "--buildlib-dir-path", type=str, default="buildlib", metavar="PATH", help="Output directory for buildlib prerequisites"
    )
    parser_prepare.add_argument("--tmp-dir-path", type=str, default="tmp", metavar="PATH", help="A temporary directory for build files")
    parser_prepare.add_argument("--no-build", action="store_true", help="Skip a build stage")
    parser_prepare.add_argument("--triplet", type=str, default=triplet, help="A toolchain triplet")
    parser_prepare.add_argument("--clean", action="store_true")

    parser_build = subparsers.add_parser(ARGPARSE_COMMAND_BUILD, formatter_class=argparse.ArgumentDefaultsHelpFormatter)
    parser_build.add_argument("--buildlib-dir-path", type=str, default="buildlib", metavar="PATH", help="Path to buildlib prerequisites")
    parser_build.add_argument("--install-dir-path", type=str, default="output", metavar="PATH", help="Path to the output directory")
    parser_build.add_argument("--cflags", type=str, default="-g -O2", metavar="CFLAGS", help="Extra target flags for GCC")
    parser_build.add_argument("--triplet", type=str, default=triplet, help="A toolchain triplet")
    parser_build.add_argument("--no-libgcc", action="store_true")
    parser_build.add_argument("--no-libstdc++", action="store_true")
    parser_build.add_argument("--no-picolibc", action="store_true")

    args = parser.parse_args()

    if args.debug:
        logging.getLogger().setLevel(logging.DEBUG)

    if args.command is None:
        print(parser.print_help())
    elif args.command == ARGPARSE_COMMAND_PREPARE_STAGE1:
        cfg = PrepareGate1Configuration(
            triplet=triplet,
            gcc_binary_path=gcc_binary_path,
            workspace_dir_path=os.path.abspath(args.workspace_dir_path),
            gcc_sources_dir_path=os.path.abspath(args.gcc_sources_dir_path),
            picolibc_sources_dir_path=os.path.abspath(args.picolibc_sources_dir_path)
        )

        prepare_stage1(cfg)
    elif args.command == ARGPARSE_COMMAND_PREPARE_STAGE2:
        cfg = PrerequisitesGeneratorConfiguration(
            triplet=args.triplet,
            build_log_path=os.path.abspath(args.build_log_path),
            build_dir_path=os.path.abspath(args.build_dir_path),
            gcc_sources_dir_path=os.path.abspath(args.gcc_sources_dir_path),
            picolibc_sources_dir_path=os.path.abspath(args.picolibc_sources_dir_path),
            buildlib_dir_path=os.path.abspath(args.buildlib_dir_path),
        )

        if args.clean:
            logging.info("Removing buildlib directory: %s", cfg.buildlib_dir_path)
            if os.path.exists(cfg.buildlib_dir_path):
                shutil.rmtree(cfg.buildlib_dir_path)

        generate_libgcc_prerequisites(cfg)
        generate_picolibc_prerequisites(cfg)
    elif args.command == ARGPARSE_COMMAND_BUILD:
        cfg = BuilderConfiguration(
            triplet=args.triplet,
            buildlib_dir_path=os.path.abspath(args.buildlib_dir_path),
            install_dir_path=os.path.abspath(args.install_dir_path),
            cflags=args.cflags,
        )

        if not args.no_libgcc:
            build_libgcc(cfg)

    return 0


if __name__ == "__main__":
    sys.exit(main())
