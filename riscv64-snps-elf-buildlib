import logging
import os
import shutil
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path

logging.basicConfig(format="%(levelname)s: %(message)s", level=logging.INFO)

@dataclass
class PrepareGate1Configuration:
    triplet: str
    gcc_binary_path: str
    workspace_dir_path: str
    gcc_sources_dir_path: str
    picolibc_sources_dir_path: str

@dataclass
class PrerequisitesGeneratorConfiguration:
    triplet: str
    build_log_path: str
    build_dir_path: str
    gcc_sources_dir_path: str
    picolibc_sources_dir_path: str
    buildlib_dir_path: str


@dataclass
class BuilderConfiguration:
    triplet: str
    buildlib_dir_path: str
    install_dir_path: str
    cflags: str

#
# Prepare stage 1 code.
#

PREPARE_STAGE1_DIR_NAME = 'stage1'
PREPARE_STAGE1_NPROC = 4

def prepare_stage1(cfg: PrepareGate1Configuration):
    # Locate target's include directory. It's required for building GCC's libraries.
    toolchain_root_dir_path = Path(cfg.gcc_binary_path).parent.parent
    include_dir_path = toolchain_root_dir_path.joinpath(cfg.triplet, "include")

    if not include_dir_path.exists():
        logging.error("Include directory for the toolchain does not exist: %s", include_dir_path)

    logging.info("Found include directory for the toolchain: %s", include_dir_path)

    # Create a stage 1 directory.
    stage1_dir_path = Path(cfg.workspace_dir_path).joinpath(PREPARE_STAGE1_DIR_NAME).absolute()
    stage1_dir_path.mkdir(parents=True)
    logging.info('Creating a workspace directory for stage 1: %s', stage1_dir_path)

    # Create a link to GCC sources so we will be able to use relative paths
    # while building libraries.
    gcc_sources_path_link = stage1_dir_path.joinpath('gcc')
    gcc_sources_path_link.symlink_to(cfg.gcc_sources_dir_path, True)
    logging.info('Creating a symbolic link to GCC sources: %s', cfg.gcc_sources_dir_path)

    # Create a link to Picolibc sources. It will be used on stage 2.
    picolibc_sources_path_link = stage1_dir_path.joinpath('picolibc')
    picolibc_sources_path_link.symlink_to(cfg.picolibc_sources_dir_path, True)
    logging.info('Creating a symbolic link to Picolibc sources: %s', cfg.picolibc_sources_dir_path)

    # Create a build directory.
    build_dir_path = stage1_dir_path.joinpath('build')
    build_dir_path.mkdir()
    logging.info('Creating a build directory for stage 1: %s', build_dir_path)

    # Construct an install directory path. It's not required further but we should
    # prevent make from trying to put headers to host's directories.
    install_dir_path = stage1_dir_path.joinpath('install')

    # Add a toolchain's GCC binary to PATH to make it visible for configure and make.
    env = os.environ.copy()
    env['PATH'] = '{}:{}'.format(os.path.dirname(cfg.gcc_binary_path), env['PATH'])

    # Now we are going to configure GCC for a random non-multilib target. We need it
    # only for logs so it does not matter what particular target is used.
    arguments = [
        '../gcc/configure',
        '--target={}'.format(cfg.triplet),
        '--prefix={}'.format(install_dir_path),
        '--disable-shared',
        '--disable-threads',
        '--enable-languages=c,c++',
        '--enable-tls',
        '--with-newlib',
        '--with-headers={}'.format(include_dir_path),
        '--disable-libmudflap',
        '--disable-libssp',
        '--disable-libquadmath',
        '--disable-libgomp',
        '--disable-nls',
        '--disable-tm-clone-registry',
        '--disable-multilib',
        '--with-arch=rv32imac',
        '--with-abi=ilp32',
        '--with-tune=rocket',
        '--with-cmodel=medlow',
        '--with-isa-spec=20191213'
    ]

    with open(stage1_dir_path.joinpath('config.log'), 'w', encoding='utf-8') as log_file:
        command = ' '.join(arguments)
        logging.info('Configuring GCC:\n%s', command)
        log_file.write(command + '\n')
        log_file.flush()

        result = subprocess.run(arguments, stdout=log_file, stderr=subprocess.STDOUT, encoding='utf-8', env=env, cwd=build_dir_path)

        if result.returncode != 0:
            logging.error("Configuring of GCC failed, check the log file.")
            sys.exit(1)

    # Now we are ready to build libgcc and libstdc++.
    arguments = [
        'make',
        '-j',
        str(PREPARE_STAGE1_NPROC),
        'all-target-libgcc',
        'all-target-libstdc++-v3'
    ]

    with open(stage1_dir_path.joinpath('build.log'), 'w', encoding='utf-8') as log_file:
        command = ' '.join(arguments)
        logging.info('Building GCC libraries:\n%s', command)
        log_file.write(command + '\n')
        log_file.flush()

        result = subprocess.run(arguments, stdout=log_file, stderr=subprocess.STDOUT, encoding='utf-8', env=env, cwd=build_dir_path)

        if result.returncode != 0:
            logging.error("Building of GCC libraries failed, check the log file.")
            sys.exit(1)

    logging.info('Finished building of GCC libraries.')


def find_library_object_files(library_path: str) -> list[str]:
    result = subprocess.run(["ar", "-t", library_path], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, encoding="utf-8")

    if result.returncode != 0:
        logging.error("Error while retrieving object files from %s:\n%s", library_path, result.stdout)
        sys.exit(1)

    return sorted(result.stdout.split())


def find_multiline_object_build_command(object_file_name: str, libgcc_build_log: str) -> str:
    grep_after_lines = 0

    while True:
        # All target object files are built with extra -MT argument. We should
        # rely on this behavior to filter objects files with the same names but
        # not related to target code.
        arguments = [
            "grep",
            "-A {}".format(grep_after_lines),
            "\\-o {} \\-MT".format(object_file_name),
            libgcc_build_log,
        ]
        result = subprocess.run(arguments, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, encoding="utf-8")

        if result.returncode != 0:
            logging.error("Error while searching a build ling in logs:\n%s", result.stdout)
            sys.exit(1)

        build_command = result.stdout.strip()

        # Some original build commands may be present as a multiline
        # with "\" endings in the original Makefile. If we encounter a build
        # command with "\" then we should grab extra lines from a build log.
        if build_command.endswith("\\"):
            grep_after_lines += 1
        else:
            return " ".join(build_command.replace("\\", "").splitlines())


def parse_dep_file_dependencies(dep_file_path: str) -> list[str]:
    logging.info("Analyzing dependencies file: %s.", dep_file_path)

    dep_file_path = Path(dep_file_path)
    dep_file_name = dep_file_path.name

    # We put all dependency from a .dep file to a set to exclude duplications.
    dependencies = set()

    # We need to perform these transformations on .dep lines to convert them
    # to clean paths:
    #
    #     1. Remove .o target (the object file itself).
    #     2. Remove all ":" and "\" symbols
    #     3. Remove dependencies with "sys-include" - they could be found in
    #        a prebuilt GCC for RISC-V.
    #     4. Convert all relative paths to absolute paths.
    #     5. Add dependencies to a set to eliminated duplications.
    with open(dep_file_path, "r", encoding="utf-8") as f:
        for path in f.readlines():
            chunks = path.strip().split()

            for chunk in chunks:
                chunk = chunk.strip()

                logging.debug("Analyzing .dep file: %s: analyzing dependency %s", dep_file_name, chunk)

                # .dep file is Makefile. Remove a target for an object file itself and
                # "\" symbols for lists of dependencies.
                if chunk.endswith("o:") or chunk == "\\":
                    continue

                # Remove headers from sys-include. Precompiled GCC will use
                # its own headers.
                if "sys-include" in chunk:
                    continue

                # Most dependencies are just empty make rules. Just remove ":".
                if chunk.endswith(":"):
                    chunk = chunk[:-1]

                if not Path(chunk).is_absolute():
                    chunk = dep_file_path.parent.joinpath(chunk)

                    # If it's a symlink then add both the symlink and
                    # the original file.
                    if not chunk.is_symlink():
                        chunk = chunk.resolve()
                    else:
                        dependencies.add(str(chunk.resolve()))

                    chunk = str(chunk)

                dependencies.add(chunk)

                logging.debug("Analyzing .dep file: %s: adding dependency %s", dep_file_name, chunk)

    return sorted(list(dependencies))


def parse_gcc_version(gcc_executable: str) -> str:
    result = subprocess.run([gcc_executable, "--version"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, encoding="utf-8")

    if result.returncode != 0:
        logging.error("Error while parsing GCC's version:\n%s", result.stdout)
        sys.exit(1)

    return result.stdout.strip().splitlines()[0].split()[-1].strip()

